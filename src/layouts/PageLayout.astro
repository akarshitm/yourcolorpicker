---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HelpDialog from "../components/HelpDialog.astro";
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/utils";

interface HelpStep {
	title: string;
	body: string;
}

interface BreadcrumbEntry {
	name: string;
	path: string;
}

interface Props {
	title: string;
	description: string;
	path: string;
	lang: Locale;
	noindex?: boolean;
	// Tool pages pass their own contextual help; every other page falls back
	// to the default "how to use the image color picker" content below.
	helpTitle?: string;
	helpSteps?: HelpStep[];
	// Omitted on the homepage — every other page names itself (and, for tool
	// pages, its "Tools" parent) in a BreadcrumbList schema.
	breadcrumbName?: string;
	breadcrumbParent?: BreadcrumbEntry;
}

const { title, description, path, lang, noindex, helpTitle, helpSteps, breadcrumbName, breadcrumbParent } = Astro.props;
const t = useTranslations(lang);
---

<Layout
	title={title}
	description={description}
	path={path}
	lang={lang}
	noindex={noindex}
	breadcrumbName={breadcrumbName}
	breadcrumbParent={breadcrumbParent}
>
	<Nav lang={lang} path={path} />
	<slot />
	<Footer lang={lang} />
	<HelpDialog title={helpTitle ?? t.help.title} steps={helpSteps ?? t.help.steps} done={t.help.done} close={t.help.close} />
</Layout>
