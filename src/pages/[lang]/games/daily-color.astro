---
import DailyColorView from "../../../components/views/DailyColorView.astro";
import { locales, defaultLocale } from "../../../i18n/config";

export function getStaticPaths() {
	return locales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Exclude<(typeof locales)[number], typeof defaultLocale> };
---

<DailyColorView lang={lang} />
