---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHeader from "../PageHeader.astro";
import { localeTags, type Locale } from "../../i18n/config";
import { useTranslations, localizePath } from "../../i18n/utils";
import { getPosts } from "../../i18n/blog";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<PageLayout title={t.blog.title} description={t.blog.description} path="/blog" lang={lang} breadcrumbName={t.blog.eyebrow}>
	<PageHeader eyebrow={t.blog.eyebrow} heading={t.blog.heading} intro={t.blog.intro} />
	<section class="mx-auto max-w-[800px] px-lg pb-3xl md:pb-4xl">
		<div class="flex flex-col gap-lg">
			{
				posts.map(({ slug, entry }) => (
					<a href={localizePath(lang, `/blog/${slug}`)} class="feature-card block no-underline hover-pop">
						<p class="type-body-sm text-mute mb-xs">
							{entry.data.publishDate.toLocaleDateString(localeTags[lang], { year: "numeric", month: "long", day: "numeric" })}
						</p>
						<h2 class="type-heading-md mb-xs text-ink">{entry.data.title}</h2>
						<p class="type-body-md text-body">{entry.data.description}</p>
					</a>
				))
			}
		</div>
	</section>
</PageLayout>
