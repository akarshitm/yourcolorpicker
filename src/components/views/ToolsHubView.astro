---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHeader from "../PageHeader.astro";
import ToolIcon, { type ToolIconName } from "../ToolIcon.astro";
import PlayGamesBanner from "../PlayGamesBanner.astro";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/utils";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const hrefs = [
	"/#tool",
	"/color-converter",
	"/gradient-maker",
	"/contrast-checker",
	"/color-blindness-simulator",
	"/color-mixer",
	"/shades-and-tints-generator",
	"/random-color-generator",
	"/color-names",
	"/palette-generator",
];
const icons: ToolIconName[] = ["picker", "converter", "gradient", "contrast", "blindness", "mixer", "shadesTints", "random", "names", "palette"];
const tools = t.toolsHub.items.map((item, i) => ({ ...item, href: hrefs[i], icon: icons[i] }));

const guides = [
	{ title: t.eyedropperGuide.heading, body: t.eyedropperGuide.intro, href: "/eyedropper-tool" },
	{ title: t.hexFromImageGuide.heading, body: t.hexFromImageGuide.intro, href: "/hex-code-from-image" },
];
---

<PageLayout title={t.toolsHub.title} description={t.toolsHub.description} path="/tools" lang={lang} breadcrumbName={t.toolsHub.heading}>
	<PageHeader eyebrow={t.toolsHub.eyebrow} heading={t.toolsHub.heading} intro={t.toolsHub.intro} />
	<section class="mx-auto max-w-[1100px] px-lg pb-3xl md:pb-4xl">
		<div class="grid gap-md sm:grid-cols-2 lg:grid-cols-3">
			{
				tools.map((tool) => (
					<a href={tool.href} class="feature-card flex gap-sm no-underline hover-pop">
						<span class="tool-card-icon">
							<ToolIcon name={tool.icon} />
						</span>
						<span>
							<h2 class="type-heading-md mb-xs text-ink">{tool.title}</h2>
							<p class="type-body-md text-body">{tool.body}</p>
						</span>
					</a>
				))
			}
		</div>

		<h2 class="type-heading-md mt-xl mb-md">{t.toolsHub.guidesHeading}</h2>
		<div class="grid gap-md sm:grid-cols-2">
			{
				guides.map((guide) => (
					<a href={guide.href} class="feature-card flex gap-sm no-underline hover-pop">
						<span class="tool-card-icon">
							<ToolIcon name="picker" />
						</span>
						<span>
							<h3 class="type-heading-md mb-xs text-ink">{guide.title}</h3>
							<p class="type-body-md text-body">{guide.body}</p>
						</span>
					</a>
				))
			}
		</div>
		<PlayGamesBanner lang={lang} />
	</section>

	<style>
		.tool-card-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 40px;
			height: 40px;
			flex-shrink: 0;
			border-radius: var(--radius-md);
			background: var(--color-hairline-soft);
			color: var(--color-ink);
		}
	</style>
</PageLayout>
