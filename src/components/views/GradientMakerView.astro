---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHeader from "../PageHeader.astro";
import RelatedTools from "../RelatedTools.astro";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/utils";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<PageLayout
	title={t.gradientMakerTool.title}
	description={t.gradientMakerTool.description}
	path="/gradient-maker"
	lang={lang}
	helpTitle={t.gradientMakerTool.help.title}
	helpSteps={t.gradientMakerTool.help.steps}
	breadcrumbName={t.gradientMakerTool.heading}
	breadcrumbParent={{ name: t.nav.tools, path: "/tools" }}
>
	<PageHeader eyebrow={t.gradientMakerTool.eyebrow} heading={t.gradientMakerTool.heading} intro={t.gradientMakerTool.intro} icon="gradient" />
	<section class="mx-auto max-w-[800px] px-lg pb-3xl md:pb-4xl">
		<div class="feature-card flex flex-col gap-lg">
			<div id="gradient-preview" class="h-[160px] w-full rounded-md border" style="border-color: var(--color-hairline);" aria-hidden="true"></div>

			<div id="gradient-stops" class="flex flex-col gap-xs" data-remove-label={t.gradientMakerTool.remove}></div>
			<button type="button" id="add-stop-btn" class="btn-ghost-sm self-start">{t.gradientMakerTool.addColor}</button>

			<div class="flex flex-wrap items-center gap-lg">
				<div class="flex items-center gap-sm">
					<label class="type-body-sm text-body flex items-center gap-xxs">
						<input type="radio" name="gradient-type" id="gradient-type-linear" value="linear" checked />
						{t.gradientMakerTool.linear}
					</label>
					<label class="type-body-sm text-body flex items-center gap-xxs">
						<input type="radio" name="gradient-type" id="gradient-type-radial" value="radial" />
						{t.gradientMakerTool.radial}
					</label>
				</div>
				<label id="angle-wrap" class="type-body-sm text-body flex items-center gap-xs">
					{t.gradientMakerTool.angle}
					<input type="range" id="gradient-angle" min="0" max="360" value="90" class="w-32 accent-[var(--color-ink)]" />
					<span id="angle-label" class="type-code">90°</span>
				</label>
			</div>

			<div>
				<div class="mb-xs flex items-center justify-between">
					<h3 class="type-heading-md">{t.gradientMakerTool.cssHeading}</h3>
					<button type="button" id="copy-gradient-btn" class="btn-ghost-sm">{t.gradientMakerTool.copyCss}</button>
				</div>
				<pre id="gradient-css" class="code-block"></pre>
			</div>
		</div>

		<div class="mt-lg">
			<h2 class="type-heading-md mb-xs">{t.gradientMakerTool.explainerHeading}</h2>
			<p class="type-body-md text-body">{t.gradientMakerTool.explainerBody}</p>
		</div>

		<RelatedTools lang={lang} current="/gradient-maker" picks={["/color-mixer", "/shades-and-tints-generator", "/palette-generator"]} />
	</section>

	<style>
		.gradient-stop {
			display: flex;
			align-items: center;
			gap: 10px;
			border: 1px solid var(--color-hairline);
			border-radius: var(--radius-sm);
			padding: 8px 10px;
		}
		.gradient-stop input[type="color"] {
			width: 36px;
			height: 36px;
			padding: 0;
			border: 1px solid var(--color-hairline);
			border-radius: var(--radius-sm);
			background: none;
			flex-shrink: 0;
		}
	</style>

	<script src="../../scripts/gradientMaker.ts"></script>
</PageLayout>
