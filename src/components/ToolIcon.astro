---
// One simple, recognizable glyph per tool, reused on both the /tools hub
// cards and each tool's own page header.
export type ToolIconName = "picker" | "converter" | "gradient" | "contrast" | "blindness" | "mixer" | "shadesTints" | "random" | "names" | "palette";

interface Props {
	name: ToolIconName;
	size?: number;
}

const { name, size = 24 } = Astro.props;

const PATHS: Record<ToolIconName, string> = {
	// Crosshair — the "pick a point" cursor a color picker uses.
	picker: '<circle cx="12" cy="12" r="6"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke-linecap="round"/>',
	// Two arrows swapping between formats.
	converter: '<path d="M7 7h12l-4-4M17 17H5l4 4" stroke-linecap="round" stroke-linejoin="round"/>',
	// Two color stops joined by a dashed line.
	gradient:
		'<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="7.5" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="16.5" cy="12" r="1.6" fill="currentColor" stroke="none"/><path d="M9 12h6" stroke-dasharray="2 2"/>',
	// Half-filled circle, the classic contrast glyph.
	contrast: '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none"/>',
	// Eye.
	blindness: '<path d="M1 12S5 5 12 5s11 7 11 7-4 7-11 7-11-7-11-7Z" stroke-linejoin="round"/><circle cx="12" cy="12" r="3"/>',
	// Two crossed brushes, each with a paint-tipped end.
	mixer:
		'<path d="M5 19 15 9" stroke-linecap="round"/><circle cx="5" cy="19" r="2.2" fill="currentColor" stroke="none"/><path d="M19 19 9 9" stroke-linecap="round"/><circle cx="19" cy="19" r="2.2" fill="currentColor" stroke="none"/>',
	// Ascending bars — a lightness ramp.
	shadesTints: '<rect x="3" y="14" width="4" height="7" rx="1"/><rect x="10" y="9" width="4" height="12" rx="1"/><rect x="17" y="3" width="4" height="18" rx="1"/>',
	// Five-pip die.
	random:
		'<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.3" fill="currentColor" stroke="none"/><circle cx="16" cy="8" r="1.3" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/><circle cx="8" cy="16" r="1.3" fill="currentColor" stroke="none"/><circle cx="16" cy="16" r="1.3" fill="currentColor" stroke="none"/>',
	// 2x2 swatch grid.
	names: '<rect x="3" y="3" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1"/>',
	// Painter's palette outline with a few paint dabs.
	palette:
		'<path d="M12 3a9 8 0 1 0 0 16c1.4 0 2-0.8 2-1.8 0-0.8-0.7-1.3-0.7-2.2a1.8 1.8 0 0 1 1.8-1.8h1.9a4 4 0 0 0 4-4C21 5.2 16.8 3 12 3Z"/><circle cx="7.5" cy="10.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="11" cy="7.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="15" cy="9" r="1.3" fill="currentColor" stroke="none"/>',
};
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	aria-hidden="true"
	set:html={PATHS[name]}
/>
