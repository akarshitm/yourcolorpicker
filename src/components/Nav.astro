---
import type { Locale } from "../i18n/config";
import { useTranslations, localizePath } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
	lang: Locale;
	path: string;
	singleLocale?: boolean;
}

const { lang, path, singleLocale } = Astro.props;
const t = useTranslations(lang);
const home = localizePath(lang, "/");
---

<header class="border-b" style="background: var(--color-canvas); border-color: var(--color-hairline);">
	<nav class="mx-auto flex max-w-[1200px] items-center justify-between px-lg py-sm">
		<a href={home} class="type-label-sm text-ink flex items-center gap-xs no-underline min-w-0">
			<img src="/nav-logo.png" width="20" height="20" alt="" class="shrink-0 rounded-full" />
			<span class="truncate">{t.brandName}</span>
		</a>
		<div class="hidden items-center gap-xs sm:flex">
			<a href={`${home}#tool`} class="nav-link">{t.nav.tool}</a>
			<a href={localizePath(lang, "/tools")} class="nav-link">{t.nav.tools}</a>
			<a href={localizePath(lang, "/games")} class="nav-link-games">
				<span class="nav-games-dot" aria-hidden="true"></span>
				{t.nav.games}
			</a>
			<a href={localizePath(lang, "/faq")} class="nav-link">{t.nav.faq}</a>
			<a href={localizePath(lang, "/blog")} class="nav-link">{t.nav.blog}</a>
			<a href={localizePath(lang, "/about")} class="nav-link">{t.nav.about}</a>
		</div>
		<div class="flex items-center gap-xs">
			<button type="button" id="help-btn" class="icon-btn" aria-label={t.nav.howToUse} title={t.nav.howToUse} aria-haspopup="dialog">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="12" cy="12" r="10"></circle>
					<path d="M12 16v-5" stroke-linecap="round"></path>
					<circle cx="12" cy="8" r="0.5" fill="currentColor" stroke-width="1.5"></circle>
				</svg>
			</button>
			<button type="button" id="theme-toggle" role="switch" aria-checked="false" class="theme-switch">
				<span class="theme-switch-knob">
					<svg id="theme-icon-sun" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path
							d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
							stroke-linecap="round"
						></path>
					</svg>
					<svg id="theme-icon-moon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden" aria-hidden="true">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
					</svg>
				</span>
			</button>
			<LanguageSwitcher lang={lang} path={path} label={t.nav.language} singleLocale={singleLocale} />
			<a href={`${home}#tool`} class="btn-primary-sm hidden sm:inline-flex">{t.nav.uploadImage}</a>
			<button type="button" id="mobile-menu-btn" class="icon-btn sm:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.nav.openMenu}>
				<svg id="menu-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
				</svg>
				<svg id="menu-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden" aria-hidden="true">
					<path d="M18 6 6 18M6 6l12 12" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</nav>
	<div id="mobile-menu" class="hidden border-t sm:hidden" style="border-color: var(--color-hairline);">
		<div class="flex flex-col gap-xxs px-lg py-sm">
			<a href={`${home}#tool`} class="nav-link-mobile">{t.nav.tool}</a>
			<a href={localizePath(lang, "/tools")} class="nav-link-mobile">{t.nav.tools}</a>
			<a href={localizePath(lang, "/games")} class="nav-link-mobile nav-link-mobile-games">
				<span class="nav-games-dot" aria-hidden="true"></span>
				{t.nav.games}
				<span class="nav-games-new">{t.games.hub.newBadge}</span>
			</a>
			<a href={`${home}#why-different`} class="nav-link-mobile">{t.nav.whyUs}</a>
			<a href={localizePath(lang, "/faq")} class="nav-link-mobile">{t.nav.faq}</a>
			<a href={localizePath(lang, "/blog")} class="nav-link-mobile">{t.nav.blog}</a>
			<a href={localizePath(lang, "/about")} class="nav-link-mobile">{t.nav.about}</a>
			<a href={localizePath(lang, "/contact")} class="nav-link-mobile">{t.nav.contact}</a>
			<a href={`${home}#tool`} class="btn-primary-sm mt-xs justify-center">{t.nav.uploadImage}</a>
		</div>
	</div>
</header>

<script src="../scripts/theme.ts"></script>

<script>
	const menuBtn = document.getElementById("mobile-menu-btn");
	const menu = document.getElementById("mobile-menu");
	const openIcon = document.getElementById("menu-icon-open");
	const closeIcon = document.getElementById("menu-icon-close");

	function setMenuOpen(open: boolean) {
		menu?.classList.toggle("hidden", !open);
		menuBtn?.setAttribute("aria-expanded", String(open));
		openIcon?.classList.toggle("hidden", open);
		closeIcon?.classList.toggle("hidden", !open);
	}

	menuBtn?.addEventListener("click", () => {
		setMenuOpen(menu?.classList.contains("hidden") ?? false);
	});
	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setMenuOpen(false));
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setMenuOpen(false);
	});
</script>

<style>
	.nav-link {
		color: var(--color-body);
		font-family: var(--font-sans);
		font-size: 14px;
		line-height: 20px;
		border-radius: 9999px;
		padding: 8px 12px;
		text-decoration: none;
	}
	.nav-link:hover {
		background: var(--color-hairline-soft);
		color: var(--color-ink);
	}

	.nav-link-mobile {
		color: var(--color-body);
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 24px;
		border-radius: var(--radius-sm);
		padding: 10px 12px;
		text-decoration: none;
	}
	.nav-link-mobile:hover,
	.nav-link-mobile:active {
		background: var(--color-hairline-soft);
		color: var(--color-ink);
	}

	.theme-switch {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		width: 44px;
		height: 24px;
		padding: 2px;
		border-radius: 9999px;
		border: 1px solid var(--color-hairline);
		background: var(--color-hairline-soft);
		cursor: pointer;
		transition: background 0.2s ease, border-color 0.2s ease;
	}
	.theme-switch[aria-checked="true"] {
		background: var(--color-ink);
		border-color: var(--color-ink);
	}
	.theme-switch-knob {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		border-radius: 9999px;
		background: var(--color-canvas-elevated);
		color: var(--color-ink);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
		transform: translateX(0);
		transition: transform 0.2s ease;
	}
	.theme-switch[aria-checked="true"] .theme-switch-knob {
		transform: translateX(20px);
	}
	/* Games: a gradient-outlined pill with a live dot, so it stands out from the
	   plain nav links without breaking the monochrome header. */
	.nav-link-games {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
		padding: 6px 12px;
		border-radius: 9999px;
		text-decoration: none;
		color: var(--color-ink);
		border: 1.5px solid transparent;
		background:
			linear-gradient(var(--color-canvas), var(--color-canvas)) padding-box,
			linear-gradient(90deg, var(--color-pink), var(--color-violet), var(--color-cyan), var(--color-link), var(--color-pink)) border-box;
		background-size:
			100% 100%,
			300% 100%;
	}
	.nav-link-games:hover {
		background:
			linear-gradient(var(--color-hairline-soft), var(--color-hairline-soft)) padding-box,
			linear-gradient(90deg, var(--color-pink), var(--color-violet), var(--color-cyan), var(--color-link), var(--color-pink)) border-box;
		background-size:
			100% 100%,
			300% 100%;
	}
	.nav-games-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-pink);
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-pink) 60%, transparent);
	}
	.nav-link-mobile-games {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--color-ink);
		font-weight: 600;
	}
	.nav-games-new {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 1px 7px;
		border-radius: 9999px;
		color: #fff;
		background: linear-gradient(90deg, var(--color-violet), var(--color-pink));
	}
	@media (prefers-reduced-motion: no-preference) {
		.nav-link-games {
			animation: nav-games-border 6s linear infinite;
		}
		.nav-games-dot {
			animation: nav-games-ping 1.8s ease-out infinite;
		}
	}
	@keyframes nav-games-border {
		from {
			background-position:
				0 0,
				0% 0;
		}
		to {
			background-position:
				0 0,
				300% 0;
		}
	}
	@keyframes nav-games-ping {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-pink) 60%, transparent);
		}
		80%,
		100% {
			box-shadow: 0 0 0 7px transparent;
		}
	}
</style>
