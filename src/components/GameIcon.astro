---
// Colorful, gently animated logos for the color games. Unlike the monochrome
// ToolIcon glyphs, these use the brand accents so games read as "play" at a
// glance. Animations only run when the user hasn't asked for reduced motion.
export type GameIconName = "runner" | "daily" | "odd" | "memory";

interface Props {
	name: GameIconName;
	size?: number;
	animated?: boolean;
}

const { name, size = 40, animated = true } = Astro.props;

// Color Runner: three perspective lanes cycling colors, with a pixel runner.
const runnerLanes = [
	"16,8 18.67,8 14.33,36 3,36",
	"18.67,8 21.33,8 25.67,36 14.33,36",
	"21.33,8 24,8 37,36 25.67,36",
];

// Daily Color: a 3x3 board of guess tiles that flip in one after another.
const dailyTiles = [
	"var(--color-mute)",
	"var(--color-warning)",
	"var(--color-mute)",
	"var(--color-warning)",
	"var(--color-cyan)",
	"var(--color-warning)",
	"var(--color-cyan)",
	"var(--color-cyan)",
	"var(--color-cyan)",
];
---

<svg
	class:list={["game-icon", `game-icon-${name}`, { "game-icon-animated": animated }]}
	width={size}
	height={size}
	viewBox="0 0 40 40"
	aria-hidden="true"
>
	{
		name === "runner" && (
			<>
				{runnerLanes.map((points, i) => (
					<polygon class="gi-lane" points={points} style={`animation-delay: ${-i * 0.9}s;`} fill={["var(--color-pink)", "var(--color-link)", "var(--color-warning)"][i]} />
				))}
				<g class="gi-runner">
					<rect x="19" y="21" width="2.4" height="2.4" fill="#3b2416" />
					<rect x="18.4" y="23.6" width="3.6" height="4.2" fill="#fff" />
					<rect x="18.4" y="27.8" width="1.4" height="3.6" fill="#2b4c7e" />
					<rect x="20.6" y="27.8" width="1.4" height="3.6" fill="#2b4c7e" />
				</g>
			</>
		)
	}
	{
		name === "daily" &&
			dailyTiles.map((fill, i) => (
				<rect
					class="gi-tile"
					x={5 + (i % 3) * 10.5}
					y={5 + Math.floor(i / 3) * 10.5}
					width="9"
					height="9"
					rx="2"
					fill={fill}
					style={`animation-delay: ${Math.floor(i / 3) * 0.35 + (i % 3) * 0.12}s;`}
				/>
			))
	}
	{
		name === "odd" &&
			Array.from({ length: 9 }, (_, i) => (
				<circle
					class:list={["gi-dot", { "gi-dot-odd": i === 5 }]}
					cx={9 + (i % 3) * 11}
					cy={9 + Math.floor(i / 3) * 11}
					r="4.6"
					fill={i === 5 ? "var(--color-pink)" : "var(--color-violet)"}
				/>
			))
	}
	{
		name === "memory" && (
			<>
				<circle cx="20" cy="20" r="16" fill="none" stroke="var(--color-hairline)" stroke-width="3" />
				<circle
					class="gi-ring"
					cx="20"
					cy="20"
					r="16"
					fill="none"
					stroke="var(--color-link)"
					stroke-width="3"
					stroke-linecap="round"
					stroke-dasharray="100.5"
					transform="rotate(-90 20 20)"
				/>
				<circle class="gi-swatch" cx="20" cy="20" r="10" fill="var(--color-pink)" />
			</>
		)
	}
</svg>

<style>
	.game-icon {
		display: block;
		flex-shrink: 0;
		overflow: visible;
	}
	.gi-tile {
		transform-box: fill-box;
		transform-origin: center;
	}
	.gi-dot {
		opacity: 0.85;
	}
	.gi-dot-odd {
		transform-box: fill-box;
		transform-origin: center;
		opacity: 1;
	}
	.gi-ring {
		stroke-dashoffset: 25;
	}

	@media (prefers-reduced-motion: no-preference) {
		.game-icon-animated .gi-lane {
			animation: gi-lanes 2.7s steps(1) infinite;
		}
		.game-icon-animated .gi-runner {
			animation: gi-bob 0.36s ease-in-out infinite alternate;
		}
		.game-icon-animated .gi-tile {
			animation: gi-flip 3.2s ease-in-out infinite both;
		}
		.game-icon-animated .gi-dot-odd {
			animation: gi-pulse 1.6s ease-in-out infinite;
		}
		.game-icon-animated .gi-ring {
			animation: gi-sweep 3s linear infinite;
		}
		.game-icon-animated .gi-swatch {
			animation: gi-hue 9s steps(1) infinite;
		}
	}

	@keyframes gi-lanes {
		0% {
			fill: var(--color-pink);
		}
		33% {
			fill: var(--color-link);
		}
		66% {
			fill: var(--color-warning);
		}
	}
	@keyframes gi-bob {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-1.5px);
		}
	}
	@keyframes gi-flip {
		0%,
		8% {
			transform: scaleY(0.1);
			opacity: 0.2;
		}
		18%,
		88% {
			transform: scaleY(1);
			opacity: 1;
		}
		100% {
			transform: scaleY(0.1);
			opacity: 0.2;
		}
	}
	@keyframes gi-pulse {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.3);
		}
	}
	@keyframes gi-sweep {
		from {
			stroke-dashoffset: 0;
		}
		to {
			stroke-dashoffset: 100.5;
		}
	}
	@keyframes gi-hue {
		0% {
			fill: var(--color-pink);
		}
		33% {
			fill: var(--color-violet);
		}
		66% {
			fill: var(--color-cyan);
		}
	}
</style>
