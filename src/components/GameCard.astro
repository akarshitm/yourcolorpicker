---
import GameIcon from "./GameIcon.astro";
import { gameList, type GameKey } from "./gameList";
import type { Locale } from "../i18n/config";
import { useTranslations, localizePath } from "../i18n/utils";

interface Props {
	lang: Locale;
	game: GameKey;
	headingLevel?: "h2" | "h3";
}

const { lang, game, headingLevel = "h2" } = Astro.props;
const t = useTranslations(lang);
const entry = gameList.find((g) => g.key === game)!;
const copy = t.games[game];
const Heading = headingLevel;
const statusLabels = JSON.stringify({
	solved: t.games.daily.solvedToday,
	waiting: t.games.daily.notPlayed,
	streak: t.games.common.streak,
	oddBest: t.games.odd.bestLevel,
	memoryBest: t.games.memory.bestScore,
	runnerBest: t.games.runner.best,
});
---

<a href={localizePath(lang, entry.href)} class="game-card no-underline" data-game-status={game} data-status-labels={statusLabels}>
	<span class="game-card-art" aria-hidden="true">
		<GameIcon name={entry.icon} size={56} />
	</span>
	<span class="game-card-body">
		<span class="game-card-badges">
			<span class="game-badge game-badge-new">{t.games.hub.newBadge}</span>
			{entry.daily && <span class="game-badge">{t.games.hub.dailyBadge}</span>}
		</span>
		<Heading class="type-heading-md text-ink">{copy.heading}</Heading>
		<span class="type-body-md text-body">{copy.cardBody}</span>
		<span class="game-card-status type-body-sm text-mute" data-status-slot></span>
		<span class="game-card-cta">
			{t.games.hub.play}
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
				<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</span>
	</span>
</a>

<script src="../scripts/gameStatus.ts"></script>

<style>
	.game-card {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		background: var(--color-canvas-elevated);
		border: 1px solid var(--color-hairline);
		border-radius: var(--radius-lg);
		padding: var(--spacing-lg);
		color: var(--color-ink);
	}
	.game-card-art {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 112px;
		border-radius: var(--radius-md);
		background:
			radial-gradient(circle at 25% 30%, color-mix(in srgb, var(--color-link) 16%, transparent), transparent 60%),
			radial-gradient(circle at 80% 70%, color-mix(in srgb, var(--color-pink) 14%, transparent), transparent 60%),
			var(--color-hairline-soft);
	}
	.game-card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
		flex: 1;
	}
	.game-card-badges {
		display: flex;
		gap: var(--spacing-xxs);
	}
	.game-badge {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 2px 8px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--color-hairline);
		color: var(--color-body);
	}
	.game-badge-new {
		border-color: transparent;
		color: #fff;
		background: linear-gradient(90deg, var(--color-violet), var(--color-pink));
	}
	.game-card-status:empty {
		display: none;
	}
	.game-card-cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		padding-top: var(--spacing-xs);
		font-weight: 600;
		font-size: 14.5px;
		color: var(--color-link);
	}
	:global([dir="rtl"]) .game-card-cta svg {
		transform: scaleX(-1);
	}
	@media (prefers-reduced-motion: no-preference) {
		.game-card {
			transition:
				transform 0.15s ease,
				border-color 0.15s ease,
				box-shadow 0.15s ease;
		}
		.game-card:hover {
			transform: translateY(-3px);
			border-color: color-mix(in srgb, var(--color-violet) 50%, var(--color-hairline));
			box-shadow: 0 14px 32px -16px color-mix(in srgb, var(--color-violet) 55%, transparent);
		}
	}
</style>
